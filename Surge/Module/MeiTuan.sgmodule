DOMAIN,httpdnsmultiapi.meituan.com,REJECT,extended-matching
DOMAIN,httpdnsmultiapivip.meituan.com,REJECT,extended-matching
DOMAIN,httpdns.meituan.com,REJECT,extended-matching
DOMAIN,httpdnsvip.meituan.com,REJECT,extended-matching
DOMAIN,dnspod.meituan.httpdns.qcloud.com,REJECT,extended-matching
DOMAIN,dnspod.meituan.httpdns.start.qcloud.com,REJECT,extended-matching
IP-CIDR,202.90.108.13/32,REJECT,no-resolve
