[URL Rewrite]
^https?:\/\/(httpdns|httpdnsvip|httpdnsmultiapi|httpdnsmultiapivip)\.meituan\.com\/ - reject
^http:\/\/103\.37\.155\.60\/fetch - reject

[Body Rewrite]
# 底部Tab栏净化（去除视频 video、小团AI xiaotuan）
http-response-jq ^https?:\/\/apimobile\.meituan\.com\/aggroup\/indexTab 'if (.data.resource.tabArea | type) == "array" and (.data.resource.tabArea | map(.tabName) | contains(["homepage","mine"])) then .data.resource.tabArea |= map(select(.tabName != "video" and .tabName != "xiaotuan")) else . end'

# 去除购物车底部推流(gwc_feed1_2265) & 我的页面底部瀑布流(personalcenter_2154)
http-response-jq ^https?:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(gwc_feed1_2265|personalcenter_2154)(\?|$) 'if (.data | type) == "array" then .data = [] | .bottom = true | .ext = ((.ext // {}) + {forbidByExp: true}) else . end'

# 去除我的页面底部交叉推荐组件(mine_cross_recommend)
http-response-jq ^https?:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display 'if (.children | type) == "array" then .children |= map(select(.name != "mine_cross_recommend")) else . end'

# 去除搜索框默认词与候选热词
http-response-jq ^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword 'if (.searchIntroduceResponse | type) == "object" then (if (.searchIntroduceResponse.defaultWordRes.defaultWordItems | type) == "array" then .searchIntroduceResponse.defaultWordRes.defaultWordItems = [] else . end) | (if (.searchIntroduceResponse.HotWordInfos | type) == "array" then .searchIntroduceResponse.HotWordInfos = [] else . end) else . end'

# 去除搜索页发现热词、美团热搜榜单及AI搜索气泡
http-response-jq ^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\/ 'if (.data.segmentsV2 | type) == "array" then .data.segmentsV2 |= map(if (.hotwordSegments | type) == "array" then .hotwordSegments |= map(select(.pageName != "EntranceHotwordsV2Hotwords" and .pageName != "EntranceHotwordsV2ContentCard")) | select((.hotwordSegments | length) > 0) else . end) else . end | if (.data.aiSearchBubble.bubbleTexts | type) == "array" then .data.aiSearchBubble.bubbleTexts = [] else . end'

# 去除购物页顶部横幅(topBannerArea)
http-response-jq ^https?:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry '(if (.resourcesMap.topBannerArea | type) == "array" then .resourcesMap.topBannerArea = [] else . end) | (if (.resource.topBannerArea | type) == "array" then .resource.topBannerArea = [] else . end) | (if (.data.resourcesMap.topBannerArea | type) == "array" then .data.resourcesMap.topBannerArea = [] else . end) | (if (.data.resource.topBannerArea | type) == "array" then .data.resource.topBannerArea = [] else . end)'

# 净化开屏广告(startupPicArea)
http-response-jq ^https?:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture '(if (.resourcesMap.startupPicArea | type) == "array" then .resourcesMap.startupPicArea = [] else . end) | (if (.resource.startupPicArea | type) == "array" then .resource.startupPicArea = [] else . end) | (if (.data.resourcesMap.startupPicArea | type) == "array" then .data.resourcesMap.startupPicArea = [] else . end) | (if (.data.resource.startupPicArea | type) == "array" then .data.resource.startupPicArea = [] else . end)'

[MITM]
hostname = %APPEND% apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, httpdns.meituan.com, httpdnsmultiapi.meituan.com
