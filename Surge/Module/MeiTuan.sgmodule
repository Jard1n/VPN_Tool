IP-CIDR,202.90.108.67/32,REJECT,no-resolve
IP-CIDR,202.90.110.36/32,REJECT,no-resolve
IP-CIDR,202.90.108.54/32,REJECT,no-resolve
IP-CIDR,202.90.108.55/32,REJECT,no-resolve
IP-CIDR,203.76.217.51/32,REJECT,no-resolve
IP-CIDR,203.76.217.53/32,REJECT,no-resolve
IP-CIDR,203.76.217.241/32,REJECT,no-resolve
IP-CIDR,203.76.217.243/32,REJECT,no-resolve
IP-CIDR,103.202.146.30/32,REJECT,no-resolve
IP-CIDR,103.202.146.49/32,REJECT,no-resolve
IP-CIDR,101.50.8.64/32,REJECT,no-resolve
IP-CIDR,103.63.160.64/32,REJECT,no-resolve
IP-CIDR,103.63.160.69/32,REJECT,no-resolve
IP-CIDR,103.37.155.77/32,REJECT,no-resolve
IP-CIDR,103.37.155.60/32,REJECT,no-resolve
IP-CIDR,111.230.0.200/32,REJECT,no-resolve
IP-CIDR,139.9.47.231/32,REJECT,no-resolve
IP-CIDR,121.37.4.167/32,REJECT,no-resolve
IP-CIDR,119.29.126.219/32,REJECT,no-resolve
IP-CIDR,106.55.217.56/32,REJECT,no-resolve
IP-CIDR,103.37.152.224/32,REJECT,no-resolve
IP-CIDR,119.29.48.215/32,REJECT,no-resolve
IP-CIDR,42.193.128.160/32,REJECT,no-resolve
IP-CIDR6,2405:1480:3000:303b::303b/128,REJECT,no-resolve
IP-CIDR6,2405:1480:1000:3::1e/128,REJECT,no-resolve
IP-CIDR6,2405:1480:1000:4::15/128,REJECT,no-resolve
IP-CIDR6,2402:4e00:40:40::2:373/128,REJECT,no-resolve

[URL Rewrite]
^https?:\/\/(httpdns|httpdnsvip|httpdnsmultiapi|httpdnsmultiapivip)\.meituan\.com\/ - reject
^http:\/\/103\.37\.155\.60\/fetch - reject

[Script]
# 底部Tab栏净化（去除视频、小团AI）
美团_底部Tab = type=http-response,pattern=^https?:\/\/apimobile\.meituan\.com\/aggroup\/indexTab,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/meituan.js
# 去除购物车底部推流 & 我的页面底部瀑布流
美团_推荐流 = type=http-response,pattern=^https?:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(gwc_feed1_2265|personalcenter_2154)(\?|$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/meituan.js
# 去除我的页面底部交叉推荐组件
美团_我的页面 = type=http-response,pattern=^https?:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/meituan.js
# 去除搜索框默认词与候选热词
美团_搜索默认词 = type=http-response,pattern=^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/meituan.js
# 去除搜索页发现热词、美团热搜榜单及AI搜索气泡
美团_搜索热推 = type=http-response,pattern=^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\/,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/meituan.js
# 禁用小团AI助手技能配置
美团_小团AI配置 = type=http-response,pattern=^https?:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/meituan.js
# 去除购物页顶部横幅
美团_购物页横幅 = type=http-response,pattern=^https?:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/meituan.js
# 净化开屏广告
美团_开屏净化 = type=http-response,pattern=^https?:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/meituan.js

[MITM]
hostname = %APPEND% apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com, httpdns.meituan.com, httpdnsmultiapi.meituan.com
