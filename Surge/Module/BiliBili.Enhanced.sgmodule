#!name = 📺 BiliBili: ⚙️ Enhanced
#!desc = 哔哩哔哩：增强模式\n中国站功能增强及UI自定义
#!openUrl = http://boxjs.com/#/app/BiliBili.Enhanced
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://biliverse.github.io/guide/enhanced
#!icon = https://github.com/Biliverse/Enhanced/raw/main/src/assets/icon_rounded.png
#!category = 🪐 Biliverse
#!arguments = Home.Switch:true,Home.Tab:"2036,2037,780,545,151",Home.Tab_default:"2037",Home.Top_left:"mine",Home.Top:"messages",Home.Top_more:"categories,search",Bottom:"home,dynamic,ogv,mall,mine",Region.Switch:true,Mine.Switch:true,Mine.iPad.Switch:true,Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = Home.Switch: [首页] 启用自定义功能\n启用后可自定义首页顶栏、标签页和底部导航栏内容。标签页由分区页的快捷访问决定。\n\nHome.Tab: [首页] 标签页\n    ├ 2036: 直播\n    ├ 2037: 推荐\n    ├ 780: 热门\n    ├ 545: 番剧\n    ├ 774: 动画（港澳台）\n    ├ 151: 影视\n    ├ 801: 韩综（港澳台）\n    └ 2280: 校园\n请选择启用的首页标签页，建议不超过7个。\n\nHome.Tab_default: [首页] 默认标签页\n    ├ 2036: 直播\n    ├ 2037: 推荐\n    ├ 780: 热门\n    ├ 545: 番剧\n    ├ 774: 动画（港澳台）\n    ├ 151: 影视\n    ├ 801: 韩综（港澳台）\n    └ 2280: 校园\n请选择启动APP时默认展示的标签页，需先将该标签页加入分区页的快捷访问。\n\nHome.Top_left: [首页] 顶栏（左侧）按钮（用户头像）\n    ├ mine: 用户中心-我的\n    └ videoshortcut: 短视频\n请选择顶栏（左侧）按钮（用户头像）的作用（在biliBili粉色版中无法修改）。\n\nHome.Top: [首页] 顶栏（右侧）按钮\n    ├ game_center: 游戏中心\n    ├ mall: 会员购\n    └ messages: 消息\n请选择启用的顶栏（右侧）按钮。\n\nHome.Top_more: [首页] 标签栏右侧按钮\n    ├ categories: 更多分区\n    └ search: 搜索\n请选择启用的首页标签栏右侧按钮。\n\nBottom: [底部] 导航栏按钮\n    ├ home: 首页\n    ├ dynamic: 动态\n    ├ publish: 发布\n    ├ ogv: 节目（港澳台）\n    ├ mall: 会员购\n    ├ messages: 消息\n    └ mine: 我的\n请选择启用的底部导航栏按钮，最多6个。\n\nRegion.Switch: [分区] 启用此标签页自定义功能\n启用后可自定义分区标签页的内容。\n\nMine.Switch: [我的] 启用此标签页自定义功能\n启用后可自定义我的标签页的服务内容。\n\nMine.iPad.Switch: [我的 iPad版] 启用此标签页自定义功能\n启用后可自定义iPad版我的标签页的服务内容。\n\nStorage: [储存] 配置类型\n    ├ Argument: 优先使用来自 $argument 的配置，$argument 不包含的设置项由 PersistentStore (BoxJs) 提供\n    ├ PersistentStore: 只使用 PersistentStore (BoxJs) 提供的配置\n    └ database: 只使用由作者的 database.mjs 文件提供的默认配置，其他任何自定义配置不再起作用\n选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 PersistentStore (BoxJs) > $argument > database。\n\nLogLevel: [调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。\n

[Map Local]
^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/" status-code=200 header="Content-Type:text/html|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/index\.mjs(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/index.mjs" status-code=200 header="Content-Type:text/javascript|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/Biliverse_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Biliverse_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/Enhanced_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Enhanced_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/Global_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Global_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/Redirect_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/Redirect_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/app\.bilibili\.com\/settings\/assets\/ADBlock_subject\.png(?:\?[^#]*)?$ data-type=file data="https://biliverse.github.io/settings/assets/ADBlock_subject.png" status-code=200 header="Content-Type:image/png|Cache-Control:no-store"
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$ data-type=file data="https://github.com/Biliverse/Enhanced/releases/download/v0.6.0/BiliBili.Enhanced.boxjs.json" status-code=200 header="Content-Type:application/json; charset=utf-8|Cache-Control:no-store|X-PreferencePanes-Version:0.6.0"

[Script]
Biliverse.Website = type=http-request, pattern=^https:\/\/biliverse\.github\.io\/settings\/theme\.css(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/mock.js.mock.js
PreferencePanes.Web = type=http-request, pattern=^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/(?:[a-zA-Z0-9_-]+\/?|assets\/(?:index|navigation)\.mjs)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/PreferencePanes.web.js
PreferencePanes.API = type=http-request, pattern=^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$, requires-body=1, max-size=65536, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/PreferencePanes.api.js
📺 BiliBili.Enhanced.x.resource.show.tab.v2 = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?, requires-body=1, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/Enhanced.response.bundle.js, argument=Home.Switch="{{{Home.Switch}}}"&Home.Tab="{{{Home.Tab}}}"&Home.Tab_default="{{{Home.Tab_default}}}"&Home.Top_left="{{{Home.Top_left}}}"&Home.Top="{{{Home.Top}}}"&Home.Top_more="{{{Home.Top_more}}}"&Bottom="{{{Bottom}}}"&Region.Switch="{{{Region.Switch}}}"&Mine.Switch="{{{Mine.Switch}}}"&Mine.iPad.Switch="{{{Mine.iPad.Switch}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.Enhanced.show.v1.Mixture.RegionShortcut.request.grpc = type=http-request, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/Enhanced.request.bundle.js, argument=Home.Switch="{{{Home.Switch}}}"&Home.Tab="{{{Home.Tab}}}"&Home.Tab_default="{{{Home.Tab_default}}}"&Home.Top_left="{{{Home.Top_left}}}"&Home.Top="{{{Home.Top}}}"&Home.Top_more="{{{Home.Top_more}}}"&Bottom="{{{Bottom}}}"&Region.Switch="{{{Region.Switch}}}"&Mine.Switch="{{{Mine.Switch}}}"&Mine.iPad.Switch="{{{Mine.iPad.Switch}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.Enhanced.show.v1.Mixture.RegionList.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$, requires-body=1, binary-body-mode=1, engine=webview, max-size=262144, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/Enhanced.response.bundle.js, argument=Home.Switch="{{{Home.Switch}}}"&Home.Tab="{{{Home.Tab}}}"&Home.Tab_default="{{{Home.Tab_default}}}"&Home.Top_left="{{{Home.Top_left}}}"&Home.Top="{{{Home.Top}}}"&Home.Top_more="{{{Home.Top_more}}}"&Bottom="{{{Bottom}}}"&Region.Switch="{{{Region.Switch}}}"&Mine.Switch="{{{Mine.Switch}}}"&Mine.iPad.Switch="{{{Mine.iPad.Switch}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.Enhanced.x.v2.account.mine = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\?, requires-body=1, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/Enhanced.response.bundle.js, argument=Home.Switch="{{{Home.Switch}}}"&Home.Tab="{{{Home.Tab}}}"&Home.Tab_default="{{{Home.Tab_default}}}"&Home.Top_left="{{{Home.Top_left}}}"&Home.Top="{{{Home.Top}}}"&Home.Top_more="{{{Home.Top_more}}}"&Bottom="{{{Bottom}}}"&Region.Switch="{{{Region.Switch}}}"&Mine.Switch="{{{Mine.Switch}}}"&Mine.iPad.Switch="{{{Mine.iPad.Switch}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.Enhanced.x.v2.region.index = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\?, requires-body=1, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/Enhanced.response.bundle.js, argument=Home.Switch="{{{Home.Switch}}}"&Home.Tab="{{{Home.Tab}}}"&Home.Tab_default="{{{Home.Tab_default}}}"&Home.Top_left="{{{Home.Top_left}}}"&Home.Top="{{{Home.Top}}}"&Home.Top_more="{{{Home.Top_more}}}"&Bottom="{{{Bottom}}}"&Region.Switch="{{{Region.Switch}}}"&Mine.Switch="{{{Mine.Switch}}}"&Mine.iPad.Switch="{{{Mine.iPad.Switch}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.Enhanced.x.v2.channel.region.list = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\?, requires-body=1, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/Enhanced.response.bundle.js, argument=Home.Switch="{{{Home.Switch}}}"&Home.Tab="{{{Home.Tab}}}"&Home.Tab_default="{{{Home.Tab_default}}}"&Home.Top_left="{{{Home.Top_left}}}"&Home.Top="{{{Home.Top}}}"&Home.Top_more="{{{Home.Top_more}}}"&Bottom="{{{Bottom}}}"&Region.Switch="{{{Region.Switch}}}"&Mine.Switch="{{{Mine.Switch}}}"&Mine.iPad.Switch="{{{Mine.iPad.Switch}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net
