#!name=净化 & 汽水音乐
#!desc=移除开屏广告、弹窗广告、播放器推广、歌曲详情界面视频推广
#!date=2026-10-30
#!category =  Block Ads


[Rule]
# 拦截字节 HTTPDNS 与商业化弹窗静态包、直播间配置
DOMAIN,dig.zjurl.cn,REJECT
DOMAIN,webcast-open.douyin.com,REJECT
DOMAIN,lf-webcast-gr-sourcecdn.bytegecko.com,REJECT
URL-REGEX,^https:\/\/lf-res-\d\.douyinstatic\.com\/.*\/commercial_popups\/,REJECT

[Body Rewrite]
# 全局 Settings 底栏净化
http-response ^https:\/\/conf\.qishui\.com\/service\/settings\/v3\/ '\["discover",\s*"listen_video",\s*"song",\s*"commerce",\s*"mine"\]' '["discover","song","mine"]' '"enable_video_live_tab":\s*1' '"enable_video_live_tab":0' '"video_tab_enable":\s*true' '"video_tab_enable":false' '"disable_preview_popup":\s*false' '"disable_preview_popup":true'
# TTNet 调度降级
http-response-jq ^https:\/\/tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com\/get_domains\/v\d\/\? 'if (.data | type) == "object" then .data.opaque_data_enabled = 0 | .data.ttnet_http_dns_enabled = 0 | .data.ttnet_quic_enabled = 0 | .data.ttnet_tt_http_dns = 0 | (if (.data.ttnet_dispatch_actions | type) == "array" then .data.ttnet_dispatch_actions |= map(select(.action != "dispatch" and .action != "tc")) else . end) else . end'
# 用户开关设置
http-response-jq ^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/user\/settings(\?|$) 'if (.luna_user_settings | type) == "object" then .luna_user_settings.popup_auto_start_ad = "0" else . end'
# 我的页面 & 侧边栏净化
http-response-jq ^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/me\? 'if (.me_tab_sidebar.sections | type) == "array" then .me_tab_sidebar.sections |= map(if (.items | type) == "array" then .items |= map(select(.item_type != "mini_game" and .item_type != "mini_program" and .item_type != "shop_order")) else . end) else . end'
# 开屏广告精准剥离（完整保留激励视频 reward_config）
http-response-jq ^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/ads\/config(\?|$) 'del(.splash_config) | if (.ad_unit_configs | type) == "array" then .ad_unit_configs |= map(select(.ad_supported_scene.ad_type != 1)) else . end'
# 歌曲推荐流：移除混入的视频轨道
http-response-jq ^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/feed\/song-tab(\?|$) 'del(.items[]? | select(.type == "video_track_mix"))'
# 播放器卡片与进度条导流
http-response-jq ^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/card(\?|$) 'del(.preview_guide) | del(.card_items[]? | select(has("priority_display")))'
# 更多面板：移除相关视频区块
http-response-jq ^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/more-panel(\?|$) 'del(.blocks[]? | select(.type == "related_video"))'

[Map Local]
# 拦截商业化促销弹窗与试听结束弹窗配置
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/commerce\/(v2\/)?upsell(s|s_config|_sort_decision)?(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 商城订单状态查询
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/commerce\/ecommerce\/order_list(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 拦截开屏 DSP 实时竞价广告与音频插播广告（放行 /luna/advert/incentive/ 供主动看广告领VIP时长使用）
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/(ads\/dsp\/retrieve|media_ads)(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 听视频/短剧提醒与信息流
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/(v2\/feed\/)?listen-video\/(reminder|module|tab-feed)(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 活动弹窗、拉新弹窗、听歌模式悬浮Widget与一起听导流
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui|api\.qishui)\.com\/luna\/(activities|acquisition|feed\/mode\/widget|social\/mate\/guidance)(\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% beta-luna.douyin.com, api.qishui.com, api5-lq.qishui.com, conf.qishui.com, dig.zjurl.cn, lf-res-*.douyinstatic.com, tnc*-*.zijieapi.com
