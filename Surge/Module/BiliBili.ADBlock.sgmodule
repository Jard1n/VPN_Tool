#!name = 📺 BiliBili: 🛡️ ADBlock
#!desc = 哔哩哔哩：去广告\n自定义去除APP内界面元素
#!openUrl = http://boxjs.com/#/app/BiliBili.ADBlock
#!author = ClydeTime[https://github.com/ClydeTime],VirgilClyne[https://github.com/VirgilClyne],app2smile[https://github.com/app2smile],RuCu6[https://github.com/RuCu6],Maasea[https://github.com/Maasea]
#!homepage = https://biliverse.github.io/guide/ad-block
#!icon = https://github.com/Biliverse/ADBlock/raw/main/src/assets/icon_rounded.png
#!category = 🪐 Biliverse
#!arguments = Splash:true,Feed.AD:true,Feed.Activity:false,Feed.Vertical:false,Feed.BlockUpLiveList:"",Feed.Story:true,Feed.StoryCommercial:true,Search.AD:true,Search.Tracking:false,Search.HotSearch:true,PGC.AD:true,Xlive.AD:true,Xlive.RemoveTrackingCallbacks:false,Xlive.RemovePreloadTracking:false,Dynamic.HotTopics:true,Dynamic.MostVisited:false,Dynamic.MostVisitedLiveOnly:false,Dynamic.AdCard:true,Dynamic.PersonalAdCard:false,View.AD:true,DM.Command:false,DM.Colorful:false,DM.Airborne:false,Reply.AD:true,Reply.CommercialLinks:false,Reply.SubjectDescriptionCommercial:false,Privacy.Tracking:true,Privacy.BlockBiliCommercial:false,Privacy.BlockThirdParty:false,Privacy.Strict:false,LogLevel:"WARN"
#!arguments-desc = Splash: [开屏] 去除广告\n是否启用此处修改\n\nFeed.AD: [推荐] 去除广告\n是否启用此处修改\n\nFeed.Activity: [推荐] 去除“活动大图”\n是否启用此处修改\n\nFeed.Vertical: [推荐] 去除竖屏视频\n是否启用此处修改\n\nFeed.BlockUpLiveList: [推荐] 屏蔽UP主直播推广\n填写up主uid，以英文逗号隔开。\n\nFeed.Story: [首页] 去除短视频流广告\n是否启用此处修改\n\nFeed.StoryCommercial: [首页] 去除Story商业按钮\n移除Story中的“助TA必火”等商业推广按钮，不删除视频卡片。\n\nSearch.AD: [搜索] 去除广告\n是否启用此处修改\n\nSearch.Tracking: [搜索] 移除响应跟踪参数\n清理SearchAll结果对象及跳转链接中的trackid、report_flow_data，不修改播放签名和预加载数据。\n\nSearch.HotSearch: [搜索] 去除“热搜”\n是否启用此处修改\n\nPGC.AD: [番剧电影] 去除广告\n是否启用此处修改\n\nXlive.AD: [直播] 去除广告\n是否启用此处修改\n\nXlive.RemoveTrackingCallbacks: [直播] 移除推荐回调\n移除直播推荐卡的show_callback与click_callback；可能影响推荐状态和翻页。\n\nXlive.RemovePreloadTracking: [直播] 移除预载链接trackid\n只移除直播small_card_v1.subtitle_style.link中的trackid，保留播放、清晰度和会话参数。\n\nDynamic.HotTopics: [动态] 去除“热门话题”\n是否启用此处修改\n\nDynamic.MostVisited: [动态] 去除“最常访问”\n是否启用此处修改\n\nDynamic.MostVisitedLiveOnly: [动态] “最常访问”仅显示直播\n是否启用此处修改\n\nDynamic.AdCard: [动态] 去除广告卡片\n是否启用此处修改\n\nDynamic.PersonalAdCard: [动态] 去除个人流广告卡片\n过滤DynAllPersonal与DynVideoPersonal中的cardType=15；当前抓包尚无广告阳性样本。\n\nView.AD: [视频] 去除播放页广告\n是否启用此处修改\n\nDM.Command: [弹幕] 去除交互式弹幕\n是否启用此处修改\n\nDM.Colorful: [弹幕] 替换彩色弹幕\n是否启用此处修改\n\nDM.Airborne: [弹幕] 空降助手\n是否启用此处修改\n\nReply.AD: [评论] 去除广告\n是否启用此处修改\n\nReply.CommercialLinks: [评论] 禁用普通评论商业跳转\n保留普通评论正文与回复树，仅移除已识别商品链接的可点击映射。\n\nReply.SubjectDescriptionCommercial: [评论] 隐藏编辑器商品能力\n移除SubjectDescription中的商品与商业助手按钮(type 5/8)；当前抓包中它们均为隐藏状态。\n\nPrivacy.Tracking: [隐私] 移除响应链接跟踪参数\n清理推荐、Story 与评论跳转链接中的高置信度归因参数，保留目标和界面功能参数。\n\nPrivacy.BlockBiliCommercial: [隐私] 阻止B站商业上报\n本地成功响应conversion/mobile/v2与fees/wise，阻止相关请求上传。\n\nPrivacy.BlockThirdParty: [隐私] 阻止第三方广告归因\n本地响应已确认的千问与Solar Engine广告展示、点击和归因请求。\n\nPrivacy.Strict: [隐私] 严格模式\n同时启用响应跟踪清理、商业链接与上报阻断，并移除直播show/click callback；可能影响跳转、推荐和翻页。\n\nLogLevel: [调试] 日志等级\n    ├ OFF: 🔴 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。\n

[Map Local]
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/configs\/ADBlock(?:\?.*)?$ data-type=file data="https://github.com/Biliverse/ADBlock/releases/download/v0.6.25/BiliBili.ADBlock.boxjs.json" status-code=200 header="Content-Type:application/json; charset=utf-8|Cache-Control:no-store|X-PreferencePanes-Version:0.6.25"
# 去除默认搜索词：最小合法空 gRPC 帧
^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ data-type=base64 data="AAAAAAA=" status-code=200 header="Content-Type:application/grpc|Content-Length:5"
# 去除搜索中的大家都在搜
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words data-type=text data="{}" header="application/json"
# 去除动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr data-type=text data="{}" header="application/json"
# 去除动态中的最常访问
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist data-type=text data="{}" header="application/json"
# BiliBili漫画去广告
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash data-type=text data="{}" header="application/json"
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash data-type=text data="{}" header="application/json"
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" header="application/json"
# 番剧页可能弹出的HTML广告
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? header="content-type: application/json" data-type=text data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}"

[Body Rewrite]
# iPad端番剧推荐列表上方广告
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'

[Script]
PreferencePanes.API = type=http-request, pattern=^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/ADBlock(?:\/(?:get|set|delete))?\/?(?:\?.*)?$, requires-body=1, max-size=65536, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/PreferencePanes.api.js
📺 BiliBili.ADBlock.feed.index.request.json = type=http-request,pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\?, engine=webview, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/ADBlock.request.bundle.js, argument=Splash="{{{Splash}}}"&Feed.AD="{{{Feed.AD}}}"&Feed.Activity="{{{Feed.Activity}}}"&Feed.Vertical="{{{Feed.Vertical}}}"&Feed.BlockUpLiveList="{{{Feed.BlockUpLiveList}}}"&Feed.Story="{{{Feed.Story}}}"&Feed.StoryCommercial="{{{Feed.StoryCommercial}}}"&Search.AD="{{{Search.AD}}}"&Search.Tracking="{{{Search.Tracking}}}"&Search.HotSearch="{{{Search.HotSearch}}}"&PGC.AD="{{{PGC.AD}}}"&Xlive.AD="{{{Xlive.AD}}}"&Xlive.RemoveTrackingCallbacks="{{{Xlive.RemoveTrackingCallbacks}}}"&Xlive.RemovePreloadTracking="{{{Xlive.RemovePreloadTracking}}}"&Dynamic.HotTopics="{{{Dynamic.HotTopics}}}"&Dynamic.MostVisited="{{{Dynamic.MostVisited}}}"&Dynamic.MostVisitedLiveOnly="{{{Dynamic.MostVisitedLiveOnly}}}"&Dynamic.AdCard="{{{Dynamic.AdCard}}}"&Dynamic.PersonalAdCard="{{{Dynamic.PersonalAdCard}}}"&View.AD="{{{View.AD}}}"&DM.Command="{{{DM.Command}}}"&DM.Colorful="{{{DM.Colorful}}}"&DM.Airborne="{{{DM.Airborne}}}"&Reply.AD="{{{Reply.AD}}}"&Reply.CommercialLinks="{{{Reply.CommercialLinks}}}"&Reply.SubjectDescriptionCommercial="{{{Reply.SubjectDescriptionCommercial}}}"&Privacy.Tracking="{{{Privacy.Tracking}}}"&Privacy.BlockBiliCommercial="{{{Privacy.BlockBiliCommercial}}}"&Privacy.BlockThirdParty="{{{Privacy.BlockThirdParty}}}"&Privacy.Strict="{{{Privacy.Strict}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.privacy.request = type=http-request, pattern=^https?:\/\/(cm\.bilibili\.com\/cm\/api\/(conversion\/mobile\/v2|fees\/wise)|adtrack\.qianwen\.com\/v3\/ad\/(show\/)?bilibili|tkio-redirect\.solar-engine\.com\/receive\/turl\/), engine=webview, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/ADBlock.request.bundle.js, argument=Splash="{{{Splash}}}"&Feed.AD="{{{Feed.AD}}}"&Feed.Activity="{{{Feed.Activity}}}"&Feed.Vertical="{{{Feed.Vertical}}}"&Feed.BlockUpLiveList="{{{Feed.BlockUpLiveList}}}"&Feed.Story="{{{Feed.Story}}}"&Feed.StoryCommercial="{{{Feed.StoryCommercial}}}"&Search.AD="{{{Search.AD}}}"&Search.Tracking="{{{Search.Tracking}}}"&Search.HotSearch="{{{Search.HotSearch}}}"&PGC.AD="{{{PGC.AD}}}"&Xlive.AD="{{{Xlive.AD}}}"&Xlive.RemoveTrackingCallbacks="{{{Xlive.RemoveTrackingCallbacks}}}"&Xlive.RemovePreloadTracking="{{{Xlive.RemovePreloadTracking}}}"&Dynamic.HotTopics="{{{Dynamic.HotTopics}}}"&Dynamic.MostVisited="{{{Dynamic.MostVisited}}}"&Dynamic.MostVisitedLiveOnly="{{{Dynamic.MostVisitedLiveOnly}}}"&Dynamic.AdCard="{{{Dynamic.AdCard}}}"&Dynamic.PersonalAdCard="{{{Dynamic.PersonalAdCard}}}"&View.AD="{{{View.AD}}}"&DM.Command="{{{DM.Command}}}"&DM.Colorful="{{{DM.Colorful}}}"&DM.Airborne="{{{DM.Airborne}}}"&Reply.AD="{{{Reply.AD}}}"&Reply.CommercialLinks="{{{Reply.CommercialLinks}}}"&Reply.SubjectDescriptionCommercial="{{{Reply.SubjectDescriptionCommercial}}}"&Privacy.Tracking="{{{Privacy.Tracking}}}"&Privacy.BlockBiliCommercial="{{{Privacy.BlockBiliCommercial}}}"&Privacy.BlockThirdParty="{{{Privacy.BlockThirdParty}}}"&Privacy.Strict="{{{Privacy.Strict}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.dm.request.grpc = type=http-request, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$, requires-body=1, binary-body-mode=1, engine=webview, max-size=65536, script-path=https://raw.githubusercontent.com/Jard1n/VPN_Tool/main/Scripts/Fries/ADBlock.request.bundle.js, argument=Splash="{{{Splash}}}"&Feed.AD="{{{Feed.AD}}}"&Feed.Activity="{{{Feed.Activity}}}"&Feed.Vertical="{{{Feed.Vertical}}}"&Feed.BlockUpLiveList="{{{Feed.BlockUpLiveList}}}"&Feed.Story="{{{Feed.Story}}}"&Feed.StoryCommercial="{{{Feed.StoryCommercial}}}"&Search.AD="{{{Search.AD}}}"&Search.Tracking="{{{Search.Tracking}}}"&Search.HotSearch="{{{Search.HotSearch}}}"&PGC.AD="{{{PGC.AD}}}"&Xlive.AD="{{{Xlive.AD}}}"&Xlive.RemoveTrackingCallbacks="{{{Xlive.RemoveTrackingCallbacks}}}"&Xlive.RemovePreloadTracking="{{{Xlive.RemovePreloadTracking}}}"&Dynamic.HotTopics="{{{Dynamic.HotTopics}}}"&Dynamic.MostVisited="{{{Dynamic.MostVisited}}}"&Dynamic.MostVisitedLiveOnly="{{{Dynamic.MostVisitedLiveOnly}}}"&Dynamic.AdCard="{{{Dynamic.AdCard}}}"&Dynamic.PersonalAdCard="{{{Dynamic.PersonalAdCard}}}"&View.AD="{{{View.AD}}}"&DM.Command="{{{DM.Command}}}"&DM.Colorful="{{{DM.Colorful}}}"&DM.Airborne="{{{DM.Airborne}}}"&Reply.AD="{{{Reply.AD}}}"&Reply.CommercialLinks="{{{Reply.CommercialLinks}}}"&Reply.SubjectDescriptionCommercial="{{{Reply.SubjectDescriptionCommercial}}}"&Privacy.Tracking="{{{Privacy.Tracking}}}"&Privacy.BlockBiliCommercial="{{{Privacy.BlockBiliCommercial}}}"&Privacy.BlockThirdParty="{{{Privacy.BlockThirdParty}}}"&Privacy.Strict="{{{Privacy.Strict}}}"&LogLevel="{{{LogLevel}}}"
